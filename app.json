{
  "expo": {
    "name": "Musclog - Lift, Log, Repeat",
    "slug": "logger",
    "version": "2.16.7",
    "scheme": "com.werules.logger",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true,
      "baseUrl": "/"
    },
    "plugins": [
      "./plugins/withGradleJvmArgs",
      "./plugins/withNativeBuildJobPools",
      "./plugins/withIosSimulatorBuildFix",
      "./plugins/withThemeAppIcons",
      "./plugins/withOptionalHardwareFeatures",
      "expo-system-ui",
      "react-native-edge-to-edge",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "es", "nl", "pt-BR", "ru"]
          }
        }
      ],
      ["expo-router", {}],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d1210",
          "image": "./assets/theme-icons/icon-bg-kinetic-depth.png",
          "imageWidth": 128
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Musclog uses the camera to scan food barcodes and nutrition labels, take meal photos for AI estimates, and receive data from another phone shown as QR codes.",
          "enableMicrophonePermission": false,
          "enableCodeScanner": true,
          "enableFrameProcessors": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "werules",
          "project": "workout"
        }
      ],
      "expo-font",
      "expo-sqlite",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildArchs": ["armeabi-v7a", "arm64-v8a", "x86_64"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "17.0",
            "extraPods": [
              {
                "name": "GoogleMLKit/MLKitCore",
                "version": "8.0.0"
              },
              {
                "name": "GoogleMLKit/BarcodeScanning",
                "version": "8.0.0"
              }
            ]
          }
        }
      ],
      "expo-background-task",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Musclog uses Face ID to unlock the parts of the app you choose to lock, such as cycle tracking or your workouts."
        }
      ],
      "./plugins/withWidgetDeepLinks",
      "./plugins/withWidgetProgressRing",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.werules.logger.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.werules.logger",
          "widgets": [
            {
              "name": "Nutrition",
              "displayName": "Nutrition Progress",
              "description": "Shows daily nutrition progress",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "initialLayout": "widgets/NutritionWidget.tsx"
              },
              "android": {
                "minWidth": 250,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "none",
                "initialLayout": "widgets/NutritionWidget.android.tsx"
              }
            },
            {
              "name": "SmartCamera",
              "displayName": "Smart Camera",
              "description": "Open Smart Camera",
              "ios": {
                "supportedFamilies": ["systemSmall"],
                "initialLayout": "widgets/SmartCameraWidget.tsx"
              },
              "android": {
                "minWidth": 60,
                "minHeight": 60,
                "targetCellWidth": 1,
                "targetCellHeight": 1,
                "resizeMode": "none",
                "initialLayout": "widgets/SmartCameraWidget.android.tsx"
              }
            },
            {
              "name": "ActivityHeatmap",
              "displayName": "Activity Heatmap",
              "description": "Shows your last 30 days of workouts and food logging",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "initialLayout": "widgets/ActivityHeatmapWidget.tsx"
              },
              "android": {
                "minWidth": 110,
                "minHeight": 40,
                "targetCellWidth": 2,
                "targetCellHeight": 1,
                "resizeMode": "none",
                "initialLayout": "widgets/ActivityHeatmapWidget.android.tsx"
              }
            },
            {
              "name": "Cycle",
              "displayName": "Cycle",
              "description": "Shows your cycle day. Private by default.",
              "ios": {
                "supportedFamilies": ["systemSmall"],
                "initialLayout": "widgets/CycleWidget.tsx"
              },
              "android": {
                "minWidth": 110,
                "minHeight": 60,
                "targetCellWidth": 2,
                "targetCellHeight": 1,
                "resizeMode": "none",
                "initialLayout": "widgets/CycleWidget.android.tsx"
              }
            }
          ],
          "enableAndroid": true
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Musclog reads workouts, nutrition and body measurements, and optionally menstrual bleeding and basal temperature when you request a cycle import.",
          "NSHealthUpdateUsageDescription": "Musclog writes workouts, nutrition and body metrics, and optionally your manually logged bleeding and basal temperature when you request a cycle export."
        }
      ],
      "expo-secure-store",
      "@sentry/react-native",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central"],
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Musclog uses Bluetooth to connect to a motion sensor you pair, to record your movement during workout sets."
        }
      ],
      "@react-native-vector-icons/material-icons",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Musclog to access your photos to select food images and exercise demonstrations.",
          "microphonePermission": false
        }
      ]
    ],
    "orientation": "default",
    "icon": "./assets/theme-icons/icon-bg-kinetic-depth.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "icon": "./assets/theme-icons/opaque/icon-bg-kinetic-depth.png",
      "backgroundColor": "#0d1210",
      "supportsTablet": true,
      "bundleIdentifier": "com.werules.logger",
      "associatedDomains": ["applinks:musclog.app"],
      "buildNumber": "335",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow Musclog to access your photos to select food images and exercise demonstrations.",
        "NSFaceIDUsageDescription": "Musclog uses Face ID to unlock the parts of the app you choose to lock, such as cycle tracking or your workouts.",
        "NSLocationWhenInUseUsageDescription": "Musclog never asks for your location. iOS requires this text because a bundled library contains location code that Musclog does not call.",
        "NSLocalNetworkUsageDescription": "Musclog uses the local network only to reach an AI model you run on your own computer or home server, if you set one up in AI settings.",
        "UIBackgroundModes": ["fetch"]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeHealth",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeFitness",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCrashData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.werules.logger",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "musclog.app",
              "path": "/open"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "versionCode": 335,
      "adaptiveIcon": {
        "foregroundImage": "./assets/theme-icons/icon-bg-kinetic-depth.png",
        "backgroundColor": "#0d1210"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.WRITE_HEIGHT",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.WRITE_BODY_FAT",
        "android.permission.health.READ_NUTRITION",
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_BASAL_METABOLIC_RATE",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_DISTANCE",
        "android.permission.health.READ_LEAN_BODY_MASS",
        "android.permission.health.READ_STEPS",
        "android.permission.health.WRITE_LEAN_BODY_MASS",
        "android.permission.health.READ_HEALTH_DATA_HISTORY",
        "android.permission.health.READ_MENSTRUATION",
        "android.permission.health.WRITE_MENSTRUATION",
        "android.permission.health.READ_BASAL_BODY_TEMPERATURE",
        "android.permission.health.WRITE_BASAL_BODY_TEMPERATURE",
        "android.permission.health.READ_INTERMENSTRUAL_BLEEDING",
        "android.permission.health.WRITE_INTERMENSTRUAL_BLEEDING"
      ],
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "7a194e96-295d-44a1-8324-78e776fe0807"
      }
    }
  }
}
