+#define OPENCV_HAL_IMPL_LASX_CMP_OP_OV(_Tpvec)                     \
+    inline _Tpvec operator != (const _Tpvec& a, const _Tpvec& b)   \
+    { return ~(a == b); }                                          \
+    inline _Tpvec operator <  (const _Tpvec& a, const _Tpvec& b)   \
+    { return b > a; }                                              \
+    inline _Tpvec operator >= (const _Tpvec& a, const _Tpvec& b)   \
+    { return ~(a < b); }                                           \
+    inline _Tpvec operator <= (const _Tpvec& a, const _Tpvec& b)   \
+    { return b >= a; }
