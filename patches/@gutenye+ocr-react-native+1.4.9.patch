+inline v_float32x4 v_invsqrt(const v_float32x4& x)
+{
+    v_float32x4 one = v_setall_f32(1.0f);
+    return v_div(one, v_sqrt(x));
+}
+#else
+inline v_float32x4 v_sqrt(const v_float32x4& x)
+{
