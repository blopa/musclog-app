+++ b/node_modules/@nozbe/watermelondb/native/ios/WatermelonDB/WMDatabaseJSIBridge.mm
@@ -0,0 +1,33 @@
+// React Native 0.88 removed RCTCxxBridge. Install the same database bindings on the JS runtime
+// through a TurboModule instead of accessing a bridge runtime pointer.
+#import <React/RCTBridgeModule.h>
+#import <ReactCommon/RCTTurboModule.h>
+#import "Database.h"
+
+using namespace facebook;
+using namespace facebook::react;
+
+class WMDatabaseRuntimeModule final : public TurboModule {
+public:
+  explicit WMDatabaseRuntimeModule(std::shared_ptr<CallInvoker> invoker)
+      : TurboModule("WMDatabaseJSIBridge", std::move(invoker)) {
+    methodMap_["install"] = MethodMetadata{0, [](jsi::Runtime &runtime, TurboModule &,
+        const jsi::Value *, size_t) -> jsi::Value {
+      watermelondb::Database::install(&runtime);
+      return jsi::Value(true);
+    }};
+  }
+};
+
+@interface WMDatabaseJSIBridge : NSObject <RCTBridgeModule, RCTTurboModule>
+@end
+
+@implementation WMDatabaseJSIBridge
+RCT_EXPORT_MODULE(WMDatabaseJSIBridge)
+
++ (BOOL)requiresMainQueueSetup { return NO; }
+
+- (std::shared_ptr<TurboModule>)getTurboModule:(const ObjCTurboModule::InitParams &)params {
+  return std::make_shared<WMDatabaseRuntimeModule>(params.jsInvoker);
+}
+@end
