diff --git a/node_modules/@nozbe/watermelondb/native/ios/WatermelonDB/WMDatabaseJSIBridge.mm b/node_modules/@nozbe/watermelondb/native/ios/WatermelonDB/WMDatabaseJSIBridge.mm
