{
  "name": "musclog",
  "version": "2.14.3",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "playwright-runner": "node tests/run-tests.js",
    "screenshots:build": "EXPO_PUBLIC_SCREENSHOT_MODE=1 npm run build-android-web",
    "screenshots:app-store:run": "npm run playwright-runner -- tests/screenshot-automation.spec.ts",
    "screenshots:website:run": "npm run playwright-runner -- --config playwright.website.config.ts",
    "screenshots:themes:run": "npm run playwright-runner -- --config playwright.website.config.ts --project=themes",
    "screenshots:carousel:run": "npm run playwright-runner -- --config playwright.website.config.ts --project=carousel",
    "screenshots:website:sync": "node scripts/sync-website-screenshots.js",
    "screenshots": "npm run screenshots:build && npm run screenshots:app-store:run",
    "screenshots:app-store": "npm run screenshots",
    "screenshots:website": "npm run screenshots:build && npm run screenshots:website:run && npm run screenshots:website:sync",
    "screenshots:themes": "npm run screenshots:build && npm run screenshots:themes:run && npm run screenshots:website:sync",
    "screenshots:carousel": "npm run screenshots:build && npm run screenshots:carousel:run",
    "screenshots:sync-legacy": "node scripts/sync-legacy-screenshots.js",
    "screenshots:all": "npm run screenshots:build && npm run screenshots:app-store:run && npm run screenshots:sync-legacy && npm run screenshots:website:run && npm run screenshots:website:sync",
    "screenshots-portrait": "npm run screenshots:build && npm run playwright-runner -- tests/screenshot-automation.spec.ts --project=portrait-6.7",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint:eslint": "eslint .",
    "lint:eslint-errors": "eslint . --quiet",
    "lint:eslint-fix": "eslint . --fix",
    "lint:all": "git add . && npm run lint:eslint-fix && npm run format && npm run prebuild:cross-platform && npm run typecheck",
    "lint:some": "git add . && npm run lint:eslint-fix && npm run format && npm run typecheck",
    "prebuild:cross-platform": "npm run prebuild",
    "bump": "ncu -u -t minor",
    "bump-any": "ncu -u",
    "clear-cache": "rm -rf node_modules/.cache /tmp/metro-cache /tmp/haste-map-metro-* .expo .next web-build",
    "bump-app-version": "node scripts/bump.js",
    "bump-minor": "node scripts/bump.js --minor",
    "bump-major": "node scripts/bump.js --major",
    "report-modal-issue": "node scripts/report-modal-issues.js",
    "compress-blog-images": "node scripts/compress-blog-images.js",
    "check-translations": "node scripts/check-translations.js",
    "check-version-sync": "node scripts/check-version-sync.js",
    "check-locale-consistency": "node scripts/check-locale-consistency.js",
    "check-palette": "node scripts/check-palette.js",
    "generate-lang": "node scripts/generateLangFile.js",
    "generate-exercises-data": "node scripts/generate-exercises-data.js",
    "generate-exercise-locales": "node scripts/generate-exercise-locales.js",
    "generate-exercise-images": "node scripts/generate-exercise-images.js",
    "generate-theme-icon-backgrounds": "node scripts/generate-theme-icon-backgrounds.js",
    "gb": "flatpak run io.mgba.mGBA gameboy/build/musclog.gbc",
    "gb:gen-foods": "node gameboy/tools/gen-foundation-foods.mjs",
    "gb:gen-exercises": "node gameboy/tools/gen-exercises.mjs",
    "gb:gen-music": "node gameboy/tools/gen-music.mjs",
    "gb:gen-themes": "node gameboy/tools/gen-themes.mjs",
    "gb:prepare-logo": "node gameboy/tools/prepare-logo.mjs",
    "gb:prepare-bg": "node gameboy/tools/prepare-background.mjs",
    "gb:setup": "node gameboy/tools/fetch-gbdk.mjs",
    "gb:lint": "node gameboy/tools/lint-c.mjs",
    "gb:lint-fix": "node gameboy/tools/lint-c.mjs --fix",
    "gb:format": "node gameboy/tools/format-c.mjs",
    "gb:format-check": "node gameboy/tools/format-c.mjs --check",
    "gb:build": "node gameboy/tools/build-gb-rom.mjs",
    "gb:copy-rom": "cp gameboy/build/musclog.gbc assets/musclog.gbc && cp gameboy/build/musclog.gbc public/images/musclog.gbc",
    "gb:manual": "node gameboy/tools/generate-manual.js",
    "sync-ml-model": "rm -f utils/repCountingModel/*.js && cp training-data/output/models/*.js utils/repCountingModel/",
    "update-reps-model": "cd training-data && .venv/bin/python train.py && cd .. && npm run sync-ml-model",
    "generate-training-html": "cd training-data && .venv/bin/python visualize_loocv.py",
    "download-training-data": "cd training-data && .venv/bin/python download_recordings.py",
    "generate-markers-html": "cd training-data && .venv/bin/python generate-markers-html.py",
    "generate-video-markers": "cd training-data && .venv/bin/python generate-video-markers.py",
    "generate-video-combined": "cd training-data && .venv/bin/python generate-video-combined.py",
    "pip-install": "cd training-data && .venv/bin/pip install -r requirements.txt",
    "postinstall": "patch-package && node scripts/sync-web-wasm.js",
    "prestart": "node scripts/sync-web-images.js",
    "start": "expo start",
    "eas-login": "eas login --browser",
    "prestart-clear": "node scripts/sync-web-images.js",
    "start-clear": "expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android-device": "expo run:android --no-build-cache --device",
    "web": "node scripts/sync-web-images.js && node scripts/sync-web-wasm.js && node scripts/generate-web-seo-files.js && expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --runInBand --silent",
    "lint": "expo lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prebuild": "expo prebuild --clean",
    "setup-android": "turtle setup:android",
    "build-android-debug": "bash scripts/run-eas-local-android-build.sh development:device",
    "build-android-debug-cache": "bash scripts/run-eas-local-android-build.sh development:device",
    "build-android": "eas build -p android --profile production --clear-cache",
    "build-android-nowait": "eas build -p android --profile production --clear-cache --no-wait",
    "build-android-local": "bash scripts/run-eas-local-android-build.sh production --clear-cache",
    "build-android-local-cache": "bash scripts/run-eas-local-android-build.sh production",
    "build-android-apk": "eas build -p android --profile production-apk --clear-cache",
    "build-android-apk-local": "bash scripts/run-eas-local-android-build.sh production-apk --clear-cache",
    "build-android-web": "node scripts/sync-web-images.js && node scripts/sync-web-wasm.js && node scripts/generate-web-seo-files.js && node scripts/export-web-wrapper.js",
    "submit-android": "eas submit --platform android",
    "build-android-preview": "eas build -p android --profile preview",
    "prebuild:android": "expo prebuild -p android --clean",
    "build-android-preview-local": "bash scripts/run-eas-local-android-build.sh preview --load-dotenv",
    "build-android-preview-local-cache": "bash scripts/run-eas-local-android-build.sh preview --load-dotenv",
    "build-ios": "node scripts/prepare-for-eas.js && eas build -p ios --profile production --clear-cache",
    "build-ios-nowait": "node scripts/prepare-for-eas.js && eas build -p ios --profile production --clear-cache --no-wait",
    "build-ios-dev": "node scripts/prepare-for-eas.js && eas build -p ios --profile development --clear-cache",
    "build-ios-preview": "node scripts/prepare-for-eas.js && eas build -p ios --profile preview --clear-cache",
    "build-ios-preview-nowait": "node scripts/prepare-for-eas.js && eas build -p ios --profile preview --clear-cache --no-wait",
    "submit-ios": "eas submit --platform ios",
    "prebuild-ios": "expo prebuild -p ios --clean",
    "prebuild-ios-simulator": "expo prebuild -p ios --clean",
    "prebuild-ios-device": "MUSCLOG_IOS_SIMULATOR_BUILD_FIX=0 expo prebuild -p ios --clean",
    "run-ios": "expo run:ios",
    "build-and-submit-ios": "eas build --platform ios --profile production --auto-submit",
    "run-ios-device": "expo run:ios --device",
    "ios-simulator": "expo run:ios --device",
    "prebuild:ios": "expo prebuild -p ios --clean",
    "check-widget-bundles": "node scripts/check-widget-bundles.js",
    "test:upgrade:web": "node tests/run-tests.js --grep \"SDK 58 compatibility\" --project portrait-6.7"
  },
  "optionalDependencies": {
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5"
  },
