  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-secure-store"
        ]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/simdjson",
          "@react-native-ml-kit/barcode-scanning",
          "rn-mlkit-ocr",
          "@musclog/witmotion-ble",
          "@bsky.app/expo-image-crop-tool",
          "react-native-barcodes-detector",
          "@gutenye/ocr-react-native"
        ],
        "listUnknownPackages": false
      }
    }
  }
