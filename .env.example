# Sentry error reporting (optional; if unset, no events are sent)
# Get your DSN from Sentry: Project Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=
# A development build sends nothing to Sentry; set to 1 to send from one.
# EXPO_PUBLIC_SENTRY_IN_DEV=1

# For EAS Build and prebuild: uploads source maps and debug symbols to Sentry.
# Do not commit this token. Set it in EAS Secrets or CI environment.
 SENTRY_AUTH_TOKEN=

# For scripts/fetch_sentry_issues.py only: a token with Issue & Event: Read, which saves the open
# Sentry issues under sentry-issues/. Not the upload token above.
SENTRY_DEV_AUTH_TOKEN=

# USDA api key
EXPO_PUBLIC_USDA_API_KEY=

# Musclog free tier (without a token the option still shows, but its requests fail with 401)
# A restricted OpenRouter key (guardrail: the free-tier model only, plus a budget). The Google AI
# Studio key itself lives in OpenRouter (BYOK), never in the app. Never put the Premium Worker's
# OpenRouter key here: everything EXPO_PUBLIC_ ships in the bundle.
EXPO_PUBLIC_MUSCLOG_GATEWAY_AUTH_TOKEN=
# Optional overrides, with their defaults:
# EXPO_PUBLIC_MUSCLOG_GATEWAY_BASE_URL=https://openrouter.ai/api/v1
# EXPO_PUBLIC_MUSCLOG_GATEWAY_MODEL=google/gemma-4-31b-it:free
# OpenRouter provider every request is pinned to (no fallbacks); empty means no pin.
# EXPO_PUBLIC_MUSCLOG_GATEWAY_PROVIDER=google-ai-studio
