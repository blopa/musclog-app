            <shape
            android:shape="ring"
            android:innerRadiusRatio="2.4"
            android:thicknessRatio="12"
            android:useLevel="true">
            <solid android:color="#FF6750A4" />
        </shape>
        </rotate>
    </item>
</layer-list>
